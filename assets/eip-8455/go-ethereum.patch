+// opReservoir implements the RESERVOIR opcode: it pushes the state-gas
+// reservoir of the current frame (the part of the frame's budget that GAS
+// does not report).
+func opReservoir(pc *uint64, evm *EVM, scope *ScopeContext) ([]byte, error) {
+	scope.Stack.get().SetUint64(scope.Contract.Gas.StateGas)
+	return nil, nil
+}
+
+// enableReservoir enables the RESERVOIR opcode (state-gas reservoir
+// introspection). It depends on the reservoir model of EIP-8037 and therefore
+// must only be applied on top of an instruction set that has it.
+func enableReservoir(jt *JumpTable) {
+	jt[RESERVOIR] = &operation{
+		execute:     opReservoir,
+		constantGas: GasQuickStep,
+		minStack:    minStack(0, 1),
+		maxStack:    maxStack(0, 1),
+	}
+}
