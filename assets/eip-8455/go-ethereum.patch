+// Tests for the RESERVOIR opcode (0x4d), which pushes the state-gas reservoir
+// of the current frame. They reuse the helpers of eip8037_test.go.
+
+package vm
+
+import (
+	"errors"
+	"math/big"
+	"testing"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core/state"
