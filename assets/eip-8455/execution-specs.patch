+# --------------------------------------------------------------------------
+# Refill visibility by frame depth (EntryPoint-shaped: top -> inner -> op)
+# --------------------------------------------------------------------------
+@legacy
+@pytest.mark.parametrize("r", [R, 0], ids=["reservoir", "below_cap"])
+def test_refill_two_levels(state_test: StateTestFiller, pre: Alloc, r: int) -> None:
+    """
+    A top frame runs each operation through an inner frame that meters it
+    with GAS and RESERVOIR, as an ERC-4337 EntryPoint does in innerHandleOp.
+    Op 1 creates a slot in a shared contract, op 2 clears it. The refill for
+    op 2 is credited where the outstanding charge is: with gas_left funding
+    (R = 0) that is the top frame, so the inner frame sees it only in
+    RESERVOIR and the top frame sees it in GAS after the inner call returns.
+    Slots (offset 2**128): 0 = inner dGAS for op 2, 1 = inner dRESERVOIR for
+    op 2, 2 = top dGAS across the inner call for op 2, 3 = top dRESERVOIR
+    across it.
+    """
+    shared = pre.deploy_contract(Op.SSTORE(FRESH, Op.ISZERO(Op.SLOAD(FRESH))) + Op.STOP)
+    op = pre.deploy_contract(Op.POP(Op.CALL(Op.GAS, shared, 0, 0, 0, 0, 0)) + Op.STOP)
+    # inner: meters the op given in calldata, returns (dGAS, dRESERVOIR) + OFFSET
+    inner = pre.deploy_contract(
+        Op.MSTORE(0, Op.GAS) + Op.MSTORE(0x20, Op.RESERVOIR)
+        + Op.POP(Op.CALL(Op.GAS, Op.CALLDATALOAD(0), 0, 0, 0, 0, 0))
+        + Op.MSTORE(0x40, Op.GAS) + Op.MSTORE(0x60, Op.RESERVOIR)
+        + Op.MSTORE(0x80, Op.ADD(Op.SUB(Op.MLOAD(0), Op.MLOAD(0x40)), OFFSET))
+        + Op.MSTORE(0xA0, Op.ADD(Op.SUB(Op.MLOAD(0x20), Op.MLOAD(0x60)), OFFSET))
+        + Op.RETURN(0x80, 64))
+
+    def run(record: bool) -> Bytecode:
+        code = (Op.MSTORE(0, op)
+                + Op.MSTORE(0x20, Op.GAS) + Op.MSTORE(0x40, Op.RESERVOIR)
+                + Op.POP(Op.CALL(Op.GAS, inner, 0, 0, 32, 0x80, 64))
+                + Op.MSTORE(0x60, Op.GAS) + Op.MSTORE(0xC0, Op.RESERVOIR))
+        if record:
+            code += (rec(0, Op.MLOAD(0x80)) + rec(1, Op.MLOAD(0xA0))
+                     + rec(2, Op.ADD(Op.SUB(Op.MLOAD(0x20), Op.MLOAD(0x60)), OFFSET))
+                     + rec(3, Op.ADD(Op.SUB(Op.MLOAD(0x40), Op.MLOAD(0xC0)), OFFSET)))
+        return code
+
+    top = pre.deploy_contract(run(False) + run(True) + Op.STOP, storage=SLOTS)
+    inner_gas = 478   # execution gas of op 2 as seen by the inner frame
+    top_gas = 704     # execution gas of the inner call as seen by the top frame
+    if r:
+        post = {0: enc(inner_gas), 1: enc(-SS), 2: enc(top_gas), 3: enc(-SS)}
+    else:
+        post = {0: enc(inner_gas), 1: enc(-SS), 2: enc(top_gas - SS), 3: enc(0)}
+    state_test(pre=pre, tx=legacy_tx(pre, top, r),
+               post={top: Account(storage={**SLOTS, **post}), shared: Account(storage={})})
