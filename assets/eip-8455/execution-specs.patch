+# --------------------------------------------------------------------------
+# System calls
+# --------------------------------------------------------------------------
+SYSTEM_RESERVOIR = 16 * SS  # STORAGE_SET x SYSTEM_MAX_SSTORES_PER_CALL
+
+
+@pytest.mark.pre_alloc_mutable
+@pytest.mark.parametrize("system_contract", [
+    pytest.param(0x000F3DF6D732807EF1319FB7B8BB8522D0BEAC02, id="beacon"),
+    pytest.param(0x0000F90827F1C53A10CB7A02335B175320002935, id="history"),
+    pytest.param(WithdrawalRequest.system_contract_address, id="withdrawals"),
+    pytest.param(ConsolidationRequest.system_contract_address, id="consolidations"),
+    pytest.param(BuilderDepositRequest.system_contract_address, id="builder_deposit"),
+    pytest.param(BuilderExitRequest.system_contract_address, id="builder_exit"),
+])
+def test_system_call(blockchain_test: BlockchainTestFiller, pre: Alloc, system_contract: int) -> None:
+    """
+    A system call reads its own reservoir, STORAGE_SET x
+    SYSTEM_MAX_SSTORES_PER_CALL, independently of any transaction. Slot 0 is
+    the first read, slot 1 the read after one new slot is created, slot 2
+    the read in a child frame.
+    """
+    address = Address(system_contract)
+    child = pre.deploy_contract(returner())
+    code = (rec(0) + Op.SSTORE(FRESH, 1) + rec(1)
+            + Op.MSTORE(0, 0) + Op.POP(Op.CALL(Op.GAS, child, 0, 0, 0, 0, 32)) + rec(2, Op.MLOAD(0))
+            + Op.STOP)
+    pre.update_account(address, code=code, storage=SLOTS)
+    probe = pre.deploy_contract(rec(0) + Op.STOP, storage=SLOTS)
+    blockchain_test(
+        pre=pre,
+        genesis_environment=Environment(gas_limit=120_000_000),
+        blocks=[Block(txs=[legacy_tx(pre, probe)])],
+        post={address: Account(storage={**SLOTS, 0: SYSTEM_RESERVOIR, 1: SYSTEM_RESERVOIR - SS,
+                                        2: SYSTEM_RESERVOIR - SS, FRESH: 1}),
+              probe: Account(storage={**SLOTS, 0: R})},
+    )
+
