+"""
+EIP-8455: RESERVOIR opcode (0x4d), pushing the state gas budget that GAS
+does not report.
+"""
+
+from typing import Callable, Dict, List
+
+from execution_testing.vm import OpcodeBase, Opcodes
+
+from ....base_fork import BaseFork
+
+
+class EIP8455(BaseFork):
+    """RESERVOIR opcode (EIP-8455)."""
+
+    @classmethod
+    def opcode_gas_map(
+        cls,
+    ) -> Dict[OpcodeBase, int | Callable[[OpcodeBase], int]]:
+        """Add RESERVOIR opcode gas cost."""
+        gas_costs = cls.gas_costs()
+        base_map = super(EIP8455, cls).opcode_gas_map()
+        return {**base_map, Opcodes.RESERVOIR: gas_costs.BASE}
+
+    @classmethod
+    def valid_opcodes(cls) -> List[Opcodes]:
+        """Add RESERVOIR opcode."""
+        return [Opcodes.RESERVOIR] + super(EIP8455, cls).valid_opcodes()
