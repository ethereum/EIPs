+# --------------------------------------------------------------------------
+# Portability: one library, both transaction models
+# --------------------------------------------------------------------------
+def portability_wrapper(pre: Alloc):
+    lib_txparam = pre.deploy_contract(Op.MSTORE(0, Op.TXPARAM(TXPARAM_STATE_GAS_LEFT)) + Op.RETURN(0, 32))
+    lib_reservoir = pre.deploy_contract(returner())
+    code = (Op.MSTORE(0, 0) + rec(0, Op.CALL(Op.GAS, lib_txparam, 0, 0, 0, 0, 32)) + rec(1, Op.MLOAD(0))
+            + Op.MSTORE(0, 0) + rec(2, Op.CALL(Op.GAS, lib_reservoir, 0, 0, 0, 0, 32)) + rec(3, Op.MLOAD(0))
+            + Op.STOP)
+    return pre.deploy_contract(code, storage=SLOTS)
+
+
+@legacy
+def test_portability_legacy(state_test: StateTestFiller, pre: Alloc) -> None:
+    """TXPARAM halts outside frame transactions; RESERVOIR works."""
+    w = portability_wrapper(pre)
+    state_test(pre=pre, tx=legacy_tx(pre, w),
+               post={w: Account(storage={**SLOTS, 0: 0, 1: 0, 2: 1, 3: R})})
+
