+# --------------------------------------------------------------------------
+# A caller bounds a child's reservoir use by reverting a wrapper frame
+# --------------------------------------------------------------------------
+@legacy
+def test_bounded_child(state_test: StateTestFiller, pre: Alloc) -> None:
+    """
+    An EntryPoint-like caller runs each operation inside a wrapper frame that
+    reads RESERVOIR before and after the operation and reverts when the
+    decrease exceeds a limit of one slot. The rollback of EIP-8037 restores
+    the reservoir, so the caller sees no change for the rejected operation.
+    Slots: 0 = 2**128 * wrapper success + wrapper output for op A (one slot),
+    1 = caller's RESERVOIR after op A, 2 = the same for op B (two slots;
+    the output is op B's own RESERVOIR reading, passed through the revert),
+    3 = caller's RESERVOIR after op B.
+    """
+    limit = SS
+    op_a = pre.deploy_contract(Op.SSTORE(FRESH, 1) + Op.STOP)
+    op_b = pre.deploy_contract(Op.SSTORE(FRESH, 1) + Op.SSTORE(FRESH + 1, 1)
+                               + Op.MSTORE(0, Op.RESERVOIR) + Op.RETURN(0, 32))
+
+    def wrapper_code(dest: int) -> Bytecode:
+        return (Op.MSTORE(0x20, Op.RESERVOIR)
+                + Op.MSTORE(0, 0)
+                + Op.POP(Op.CALL(Op.GAS, Op.CALLDATALOAD(0), 0, 0, 0, 0, 32))
+                + Op.MSTORE(0x60, Op.MLOAD(0))
+                + Op.MSTORE(0x40, Op.SUB(Op.MLOAD(0x20), Op.RESERVOIR))
+                + Op.JUMPI(Op.PUSH2(dest), Op.GT(Op.MLOAD(0x40), limit))
+                + Op.RETURN(0x40, 32)
+                + Op.JUMPDEST + Op.REVERT(0x60, 32))
+
+    dest = len(wrapper_code(0)) - len(Op.JUMPDEST + Op.REVERT(0x60, 32))
+    wrapper = pre.deploy_contract(wrapper_code(dest))
+
+    def run(target, slot_result: int, slot_after: int) -> Bytecode:
+        return (Op.MSTORE(0, target) + Op.MSTORE(0x20, 0)
+                + Op.MSTORE(0x40, Op.CALL(Op.GAS, wrapper, 0, 0, 32, 0x20, 32))
+                + Op.SSTORE(slot_result, Op.ADD(Op.MUL(Op.MLOAD(0x40), 1 << 128), Op.MLOAD(0x20)))
+                + rec(slot_after))
+
+    caller = pre.deploy_contract(run(op_a, 0, 1) + run(op_b, 2, 3) + Op.STOP, storage=SLOTS)
+    state_test(pre=pre, tx=legacy_tx(pre, caller),
+               post={caller: Account(storage={**SLOTS, 0: (1 << 128) + SS, 1: R - SS,
+                                              2: R - 3 * SS, 3: R - SS}),
+                     op_a: Account(storage={FRESH: 1}), op_b: Account(storage={})})
+
