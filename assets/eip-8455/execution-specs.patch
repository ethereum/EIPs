+def state_gas_budget(evm: Evm) -> None:
+    """
+    Push the state gas available to the executing frame that `GAS`
+    does not report (the `RESERVOIR` instruction).
+
+    Under the EIP-8037 reservoir model this is the call frame's state
+    gas reservoir. Inside an EIP-8141 frame transaction it is the
+    executing frame's `state_gas_left` pool, the value `TXPARAM`
+    returns for `TXPARAM_STATE_GAS_LEFT`.
+
+    Parameters
+    ----------
+    evm :
+        The current EVM frame.
+
+    """
+    # STACK
+    pass
+
+    # GAS
+    charge_gas(evm, GasCosts.OPCODE_RESERVOIR)
+
+    # OPERATION
+    frame_context = evm.tx_env.frame_context
+    reservoir = evm.gas_meter.reservoir
+    if frame_context is not None:
+        # EIP-8141 frame transaction: the frame's explicit state pool.
+        value = U256(frame_context.state_gas_left)
+    else:
+        # EIP-8037 reservoir model.
+        assert reservoir is not None
+        value = U256(reservoir.state_gas_left)
+    push(evm.stack, value)
+
+    # PROGRAM COUNTER
+    evm.pc += Uint(1)
+
+
