+# --------------------------------------------------------------------------
+# Bundle ledger: signed per-operation measurements reconcile
+# --------------------------------------------------------------------------
+OFFSET = 1 << 128  # keeps every stored result non-zero, so instrumentation never clears a slot
+
+
+def enc(x: int) -> int:
+    return x + OFFSET
+
+
+@legacy
+@pytest.mark.parametrize("variant,r,m1,m2", [
+    ("create_clear", R, 116_195, -94_545),
+    ("create_clear", 0, 116_195, -94_545),
+    ("create_keep", R, 116_195, 3_044),
+    ("none", R, 3_044, 3_044),
+], ids=["create_clear", "create_clear_below_cap", "create_keep", "control"])
+def test_bundle_ledger(state_test: StateTestFiller, pre: Alloc, variant: str, r: int,
+                       m1: int, m2: int) -> None:
+    """
+    An EntryPoint-like caller meters two operations with GAS + RESERVOIR and
+    stores the signed deltas. Operation 1 creates a slot in a shared
+    contract; operation 2 clears it. Slots 0..3 hold op1 dGAS, op1
+    dRESERVOIR, op2 dGAS, op2 dRESERVOIR (before minus after, each plus
+    2**128 so that no stored value is zero); slots 4 and 5 hold the
+    per-operation sums with the same offset. The sums are
+    the same with and without a reservoir; only the split differs.
+    """
+    shared = pre.deploy_contract(Op.SSTORE(FRESH, Op.ISZERO(Op.SLOAD(FRESH))) + Op.STOP)
+    call_shared = Op.POP(Op.CALL(Op.GAS, shared, 0, 0, 0, 0, 0)) + Op.STOP
+    op1 = pre.deploy_contract(Op.STOP if variant == "none" else call_shared)
+    op2 = pre.deploy_contract(call_shared if variant == "create_clear" else Op.STOP)
+
+    def meter(target, base):
+        return (Op.MSTORE(base, Op.GAS) + Op.MSTORE(base + 0x20, Op.RESERVOIR)
+                + Op.POP(Op.CALL(Op.GAS, target, 0, 0, 0, 0, 0))
+                + Op.MSTORE(base + 0x40, Op.GAS) + Op.MSTORE(base + 0x60, Op.RESERVOIR))
+
+    def d(a, b):
+        return Op.ADD(Op.SUB(Op.MLOAD(a), Op.MLOAD(b)), OFFSET)
+
+    code = (meter(op1, 0x00) + meter(op2, 0x80)
+            + rec(0, d(0x00, 0x40)) + rec(1, d(0x20, 0x60))
+            + rec(2, d(0x80, 0xC0)) + rec(3, d(0xA0, 0xE0))
+            + rec(4, Op.SUB(Op.ADD(Op.SLOAD(0), Op.SLOAD(1)), OFFSET))
+            + rec(5, Op.SUB(Op.ADD(Op.SLOAD(2), Op.SLOAD(3)), OFFSET))
+            + Op.STOP)
+    bundler = pre.deploy_contract(code, storage=SLOTS)
+    if variant == "none":
+        g1, s1, g2, s2 = m1, 0, m2, 0
+    elif variant == "create_keep":
+        g1, s1, g2, s2 = (m1 - SS, SS, m2, 0) if r else (m1, 0, m2, 0)
+    else:
+        g1, s1, g2, s2 = (m1 - SS, SS, m2 + SS, -SS) if r else (m1, 0, m2, 0)
+    state_test(pre=pre, tx=legacy_tx(pre, bundler, r),
+               post={bundler: Account(storage={**SLOTS, 0: enc(g1), 1: enc(s1),
+                                               2: enc(g2), 3: enc(s2),
+                                               4: enc(m1), 5: enc(m2)}),
+                     shared: Account(storage={FRESH: 1} if variant == "create_keep" else {})})
+
