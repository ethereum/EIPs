+@legacy
+@pytest.mark.parametrize("depth,ok", [(1023, 1), (1024, 0)], ids=["fits", "overflow"])
+def test_stack_overflow(state_test: StateTestFiller, pre: Alloc, depth: int, ok: int) -> None:
+    pushes = Bytecode()
+    for _ in range(depth):
