+@legacy
+@pytest.mark.parametrize("opcode", ["create", "create2"])
+@pytest.mark.parametrize("ending", ["return", "revert"])
+def test_create_paths(state_test: StateTestFiller, pre: Alloc, opcode: str, ending: str) -> None:
+    ic = initcode(ending)
+    size = len(ic)
+    store_ic = Op.MSTORE(0, Op.PUSH32(bytes(ic).ljust(32, b"\0"))) if size <= 32 else None
+    assert store_ic is not None, size
+    create = Op.CREATE(0, 0, size) if opcode == "create" else Op.CREATE2(0, 0, size, 7)
+    probe = pre.deploy_contract(store_ic + Op.POP(create) + rec(1) + Op.STOP, storage=SLOTS)
+    if opcode == "create":
+        new = compute_create_address(address=probe, nonce=1)
+    else:
+        new = compute_create2_address(address=probe, salt=7, initcode=bytes(ic))
+    if ending == "return":
+        after = R - NEW_ACCOUNT - SS - len(DEPLOYED) * CPSB
+        post = {probe: Account(storage={**SLOTS, 1: after}),
+                new: Account(storage={0: R - NEW_ACCOUNT}, code=DEPLOYED)}
+    else:
+        post = {probe: Account(storage={**SLOTS, 1: R}), new: Account.NONEXISTENT}
+    state_test(pre=pre, tx=legacy_tx(pre, probe), post=post)
+
