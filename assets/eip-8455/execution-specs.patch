+"""
+Tests for the draft RESERVOIR opcode (0x4d): the state gas budget that
+GAS does not report. Reservoir-model cases (EIP-8037 transactions) are
+marked `frame_tx_incompatible` because their expected values are
+model-specific; EIP-8141 cases are written as frame transactions.
+"""
+
+import pytest
+from execution_testing import (
+    EOA,
+    Address,
+    Account,
+    Alloc,
+    AuthorizationTuple,
+    Block,
+    BlockchainTestFiller,
+    BuilderDepositRequest,
+    BuilderExitRequest,
+    ConsolidationRequest,
+    Environment,
+    Bytecode,
+    Op,
+    StateTestFiller,
+    Transaction,
+    WithdrawalRequest,
+    compute_create_address,
+    compute_create2_address,
+)
+
+from ..eip8141_frame_transactions.helpers import default_frame, verify_frame
+
+pytestmark = pytest.mark.valid_from("Bogota")
+legacy = pytest.mark.frame_tx_incompatible
+
+TX_MAX = 16_777_216
+CPSB = 1530
+SS = 64 * CPSB          # 97,920  new storage slot
+NEW_ACCOUNT = 120 * CPSB  # 183,600 new account
+AUTH_BASE = 23 * CPSB   # 35,190  delegation indicator
+R = 500_000
+FILL = 0xDEAD           # pre-populated result slots: writes create no state
+SLOTS = {i: FILL for i in range(8)}
+FRESH = 0x100           # a slot that starts empty
+
+TXPARAM_STATE_GAS_LEFT = 0x0C
+
+
+def rec(i: int, value: Bytecode = Op.RESERVOIR) -> Bytecode:
+    return Op.SSTORE(i, value)
+
+
+def returner(prefix: Bytecode = Bytecode()) -> Bytecode:
+    """Child code: run prefix, return RESERVOIR as one word."""
+    return prefix + Op.MSTORE(0, Op.RESERVOIR) + Op.RETURN(0, 32)
+
+
+def call_and_record(op, target, slot_child: int, slot_after: int, value: int = 0,
+                    gas: Bytecode | int = Op.GAS) -> Bytecode:
+    if op in (Op.CALL, Op.CALLCODE):
+        c = op(gas, target, value, 0, 0, 0, 32)
+    else:
+        c = op(gas, target, 0, 0, 0, 32)
+    return Op.MSTORE(0, 0) + Op.POP(c) + rec(slot_child, Op.MLOAD(0)) + rec(slot_after)
+
+
+def legacy_tx(pre: Alloc, to, r: int = R, **kw) -> Transaction:
+    gas = TX_MAX + r if r else 1_000_000
+    return Transaction(sender=pre.fund_eoa(), to=to, gas_limit=gas, **kw)
+
+
