+def test_frame_cross_frame_refill(state_test: StateTestFiller, pre: Alloc) -> None:
+    """
+    Frame 1 creates a slot; frame 2 clears it. The refill is attributed
+    to frame 1's receipt and is not credited to frame 2's pool.
+    """
+    s1, s2 = 300_000, 250_000
+    create_part = Op.SSTORE(FRESH, 1) + rec(0) + Op.STOP
+    head_len = len(Op.JUMPI(0xFF, Op.CALLDATASIZE))
+    dest = head_len + len(create_part)
+    x = pre.deploy_contract(
+        Op.JUMPI(dest, Op.CALLDATASIZE) + create_part
+        + Op.JUMPDEST + Op.SSTORE(FRESH, 0) + rec(1) + Op.STOP, storage=SLOTS)
+    assert len(Op.JUMPI(dest, Op.CALLDATASIZE)) == head_len
+    tx = frame_tx(pre.fund_eoa(),
+                  default_frame(target=x, gas_limit=200_000, state_gas_limit=s1),
+                  default_frame(target=x, gas_limit=200_000, state_gas_limit=s2, data=b"\x01"))
+    state_test(pre=pre, tx=tx, post={x: Account(storage={**SLOTS, 0: s1 - SS, 1: s2})})
+
+
+def test_frame_child_sees_frame_pool(state_test: StateTestFiller, pre: Alloc) -> None:
+    child = pre.deploy_contract(returner(Op.SSTORE(FRESH, 1)))
+    probe = pre.deploy_contract(call_and_record(Op.CALL, child, 1, 0) + Op.STOP, storage=SLOTS)
+    tx = frame_tx(pre.fund_eoa(), default_frame(target=probe, gas_limit=500_000, state_gas_limit=S))
+    state_test(pre=pre, tx=tx, post={probe: Account(storage={**SLOTS, 0: S - SS, 1: S - SS}),
+                                     child: Account(storage={FRESH: 1})})
+
+
+@legacy
+@pytest.mark.parametrize("r,child_seen,caller_after,gas_rose",
+                         [(R, R, R, 0), (0, SS, 0, 1)], ids=["reservoir", "below_cap"])
+def test_cross_frame_refill_merge(state_test: StateTestFiller, pre: Alloc, r: int,
+                                  child_seen: int, caller_after: int, gas_rose: int) -> None:
+    """
+    The caller creates a slot in E (a first call), then calls E again to
+    clear it. The refill lands in the second child's reservoir; on return
+    the EIP-8037 merge step moves it to gas_left when gas_left paid for the
+    slot. Stored: slot 0 = RESERVOIR in the clearing child, slot 1 = the
+    caller's RESERVOIR after it, slot 2 = 1 if the caller's GAS rose across
+    the call, slot 3 = 1 if GAS + RESERVOIR rose across the call.
+    """
+    shared = pre.deploy_contract(Op.SSTORE(FRESH, Op.ISZERO(Op.SLOAD(FRESH)))
+                                 + Op.MSTORE(0, Op.RESERVOIR) + Op.RETURN(0, 32))
+    code = (Op.POP(Op.CALL(Op.GAS, shared, 0, 0, 0, 0, 0))
+            + Op.MSTORE(0x20, Op.GAS) + Op.MSTORE(0x40, Op.RESERVOIR)
+            + Op.MSTORE(0, 0) + Op.POP(Op.CALL(Op.GAS, shared, 0, 0, 0, 0, 32))
+            + Op.MSTORE(0x60, Op.GAS) + Op.MSTORE(0x80, Op.RESERVOIR)
+            + rec(0, Op.MLOAD(0)) + rec(1, Op.MLOAD(0x80))
+            + rec(2, Op.GT(Op.MLOAD(0x60), Op.MLOAD(0x20)))
+            + rec(3, Op.GT(Op.ADD(Op.MLOAD(0x60), Op.MLOAD(0x80)),
+                           Op.ADD(Op.MLOAD(0x20), Op.MLOAD(0x40))))
+            + Op.STOP)
+    caller = pre.deploy_contract(code, storage=SLOTS)
+    state_test(pre=pre, tx=legacy_tx(pre, caller, r),
+               post={caller: Account(storage={**SLOTS, 0: child_seen, 1: caller_after,
+                                              2: gas_rose, 3: 1}),
+                     shared: Account(storage={})})
+
+
+# --------------------------------------------------------------------------
+# System calls
+# --------------------------------------------------------------------------
+SYSTEM_RESERVOIR = 16 * SS  # STORAGE_SET x SYSTEM_MAX_SSTORES_PER_CALL
+
+
+@pytest.mark.pre_alloc_mutable
+@pytest.mark.parametrize("system_contract", [
+    pytest.param(0x000F3DF6D732807EF1319FB7B8BB8522D0BEAC02, id="beacon"),
+    pytest.param(0x0000F90827F1C53A10CB7A02335B175320002935, id="history"),
+    pytest.param(WithdrawalRequest.system_contract_address, id="withdrawals"),
+    pytest.param(ConsolidationRequest.system_contract_address, id="consolidations"),
+    pytest.param(BuilderDepositRequest.system_contract_address, id="builder_deposit"),
+    pytest.param(BuilderExitRequest.system_contract_address, id="builder_exit"),
+])
+def test_system_call(blockchain_test: BlockchainTestFiller, pre: Alloc, system_contract: int) -> None:
+    """
+    A system call reads its own reservoir, STORAGE_SET x
+    SYSTEM_MAX_SSTORES_PER_CALL, independently of any transaction. Slot 0 is
+    the first read, slot 1 the read after one new slot is created, slot 2
+    the read in a child frame.
+    """
+    address = Address(system_contract)
+    child = pre.deploy_contract(returner())
+    code = (rec(0) + Op.SSTORE(FRESH, 1) + rec(1)
+            + Op.MSTORE(0, 0) + Op.POP(Op.CALL(Op.GAS, child, 0, 0, 0, 0, 32)) + rec(2, Op.MLOAD(0))
+            + Op.STOP)
+    pre.update_account(address, code=code, storage=SLOTS)
+    probe = pre.deploy_contract(rec(0) + Op.STOP, storage=SLOTS)
+    blockchain_test(
+        pre=pre,
+        genesis_environment=Environment(gas_limit=120_000_000),
+        blocks=[Block(txs=[legacy_tx(pre, probe)])],
+        post={address: Account(storage={**SLOTS, 0: SYSTEM_RESERVOIR, 1: SYSTEM_RESERVOIR - SS,
+                                        2: SYSTEM_RESERVOIR - SS, FRESH: 1}),
+              probe: Account(storage={**SLOTS, 0: R})},
+    )
+
+
+# --------------------------------------------------------------------------
+# Bundle ledger: signed per-operation measurements reconcile
+# --------------------------------------------------------------------------
+OFFSET = 1 << 128  # keeps every stored result non-zero, so instrumentation never clears a slot
+
+
+def enc(x: int) -> int:
+    return x + OFFSET
+
+
+@legacy
+@pytest.mark.parametrize("variant,r,m1,m2", [
+    ("create_clear", R, 116_195, -94_545),
+    ("create_clear", 0, 116_195, -94_545),
+    ("create_keep", R, 116_195, 3_044),
+    ("none", R, 3_044, 3_044),
+], ids=["create_clear", "create_clear_below_cap", "create_keep", "control"])
+def test_bundle_ledger(state_test: StateTestFiller, pre: Alloc, variant: str, r: int,
+                       m1: int, m2: int) -> None:
+    """
+    An EntryPoint-like caller meters two operations with GAS + RESERVOIR and
+    stores the signed deltas. Operation 1 creates a slot in a shared
+    contract; operation 2 clears it. Slots 0..3 hold op1 dGAS, op1
+    dRESERVOIR, op2 dGAS, op2 dRESERVOIR (before minus after, each plus
+    2**128 so that no stored value is zero); slots 4 and 5 hold the
+    per-operation sums with the same offset. The sums are
+    the same with and without a reservoir; only the split differs.
+    """
+    shared = pre.deploy_contract(Op.SSTORE(FRESH, Op.ISZERO(Op.SLOAD(FRESH))) + Op.STOP)
+    call_shared = Op.POP(Op.CALL(Op.GAS, shared, 0, 0, 0, 0, 0)) + Op.STOP
+    op1 = pre.deploy_contract(Op.STOP if variant == "none" else call_shared)
+    op2 = pre.deploy_contract(call_shared if variant == "create_clear" else Op.STOP)
+
+    def meter(target, base):
+        return (Op.MSTORE(base, Op.GAS) + Op.MSTORE(base + 0x20, Op.RESERVOIR)
+                + Op.POP(Op.CALL(Op.GAS, target, 0, 0, 0, 0, 0))
+                + Op.MSTORE(base + 0x40, Op.GAS) + Op.MSTORE(base + 0x60, Op.RESERVOIR))
+
+    def d(a, b):
+        return Op.ADD(Op.SUB(Op.MLOAD(a), Op.MLOAD(b)), OFFSET)
+
+    code = (meter(op1, 0x00) + meter(op2, 0x80)
+            + rec(0, d(0x00, 0x40)) + rec(1, d(0x20, 0x60))
+            + rec(2, d(0x80, 0xC0)) + rec(3, d(0xA0, 0xE0))
+            + rec(4, Op.SUB(Op.ADD(Op.SLOAD(0), Op.SLOAD(1)), OFFSET))
+            + rec(5, Op.SUB(Op.ADD(Op.SLOAD(2), Op.SLOAD(3)), OFFSET))
+            + Op.STOP)
+    bundler = pre.deploy_contract(code, storage=SLOTS)
+    if variant == "none":
+        g1, s1, g2, s2 = m1, 0, m2, 0
+    elif variant == "create_keep":
+        g1, s1, g2, s2 = (m1 - SS, SS, m2, 0) if r else (m1, 0, m2, 0)
+    else:
+        g1, s1, g2, s2 = (m1 - SS, SS, m2 + SS, -SS) if r else (m1, 0, m2, 0)
+    state_test(pre=pre, tx=legacy_tx(pre, bundler, r),
+               post={bundler: Account(storage={**SLOTS, 0: enc(g1), 1: enc(s1),
+                                               2: enc(g2), 3: enc(s2),
+                                               4: enc(m1), 5: enc(m2)}),
+                     shared: Account(storage={FRESH: 1} if variant == "create_keep" else {})})
+
+
+# --------------------------------------------------------------------------
+# A caller bounds a child's reservoir use by reverting a wrapper frame
+# --------------------------------------------------------------------------
+@legacy
+def test_bounded_child(state_test: StateTestFiller, pre: Alloc) -> None:
+    """
+    An EntryPoint-like caller runs each operation inside a wrapper frame that
+    reads RESERVOIR before and after the operation and reverts when the
+    decrease exceeds a limit of one slot. The rollback of EIP-8037 restores
+    the reservoir, so the caller sees no change for the rejected operation.
+    Slots: 0 = 2**128 * wrapper success + wrapper output for op A (one slot),
+    1 = caller's RESERVOIR after op A, 2 = the same for op B (two slots;
+    the output is op B's own RESERVOIR reading, passed through the revert),
+    3 = caller's RESERVOIR after op B.
+    """
+    limit = SS
+    op_a = pre.deploy_contract(Op.SSTORE(FRESH, 1) + Op.STOP)
+    op_b = pre.deploy_contract(Op.SSTORE(FRESH, 1) + Op.SSTORE(FRESH + 1, 1)
+                               + Op.MSTORE(0, Op.RESERVOIR) + Op.RETURN(0, 32))
+
+    def wrapper_code(dest: int) -> Bytecode:
+        return (Op.MSTORE(0x20, Op.RESERVOIR)
+                + Op.MSTORE(0, 0)
+                + Op.POP(Op.CALL(Op.GAS, Op.CALLDATALOAD(0), 0, 0, 0, 0, 32))
+                + Op.MSTORE(0x60, Op.MLOAD(0))
+                + Op.MSTORE(0x40, Op.SUB(Op.MLOAD(0x20), Op.RESERVOIR))
+                + Op.JUMPI(Op.PUSH2(dest), Op.GT(Op.MLOAD(0x40), limit))
+                + Op.RETURN(0x40, 32)
+                + Op.JUMPDEST + Op.REVERT(0x60, 32))
+
+    dest = len(wrapper_code(0)) - len(Op.JUMPDEST + Op.REVERT(0x60, 32))
+    wrapper = pre.deploy_contract(wrapper_code(dest))
+
+    def run(target, slot_result: int, slot_after: int) -> Bytecode:
+        return (Op.MSTORE(0, target) + Op.MSTORE(0x20, 0)
+                + Op.MSTORE(0x40, Op.CALL(Op.GAS, wrapper, 0, 0, 32, 0x20, 32))
+                + Op.SSTORE(slot_result, Op.ADD(Op.MUL(Op.MLOAD(0x40), 1 << 128), Op.MLOAD(0x20)))
+                + rec(slot_after))
+
+    caller = pre.deploy_contract(run(op_a, 0, 1) + run(op_b, 2, 3) + Op.STOP, storage=SLOTS)
+    state_test(pre=pre, tx=legacy_tx(pre, caller),
+               post={caller: Account(storage={**SLOTS, 0: (1 << 128) + SS, 1: R - SS,
+                                              2: R - 3 * SS, 3: R - SS}),
+                     op_a: Account(storage={FRESH: 1}), op_b: Account(storage={})})
+
+
+# --------------------------------------------------------------------------
+# Refill visibility by frame depth (EntryPoint-shaped: top -> inner -> op)
+# --------------------------------------------------------------------------
+@legacy
+@pytest.mark.parametrize("r", [R, 0], ids=["reservoir", "below_cap"])
+def test_refill_two_levels(state_test: StateTestFiller, pre: Alloc, r: int) -> None:
+    """
+    A top frame runs each operation through an inner frame that meters it
+    with GAS and RESERVOIR, as an ERC-4337 EntryPoint does in innerHandleOp.
+    Op 1 creates a slot in a shared contract, op 2 clears it. The refill for
+    op 2 is credited where the outstanding charge is: with gas_left funding
+    (R = 0) that is the top frame, so the inner frame sees it only in
+    RESERVOIR and the top frame sees it in GAS after the inner call returns.
+    Slots (offset 2**128): 0 = inner dGAS for op 2, 1 = inner dRESERVOIR for
+    op 2, 2 = top dGAS across the inner call for op 2, 3 = top dRESERVOIR
+    across it.
+    """
+    shared = pre.deploy_contract(Op.SSTORE(FRESH, Op.ISZERO(Op.SLOAD(FRESH))) + Op.STOP)
+    op = pre.deploy_contract(Op.POP(Op.CALL(Op.GAS, shared, 0, 0, 0, 0, 0)) + Op.STOP)
+    # inner: meters the op given in calldata, returns (dGAS, dRESERVOIR) + OFFSET
+    inner = pre.deploy_contract(
+        Op.MSTORE(0, Op.GAS) + Op.MSTORE(0x20, Op.RESERVOIR)
+        + Op.POP(Op.CALL(Op.GAS, Op.CALLDATALOAD(0), 0, 0, 0, 0, 0))
+        + Op.MSTORE(0x40, Op.GAS) + Op.MSTORE(0x60, Op.RESERVOIR)
+        + Op.MSTORE(0x80, Op.ADD(Op.SUB(Op.MLOAD(0), Op.MLOAD(0x40)), OFFSET))
+        + Op.MSTORE(0xA0, Op.ADD(Op.SUB(Op.MLOAD(0x20), Op.MLOAD(0x60)), OFFSET))
+        + Op.RETURN(0x80, 64))
+
+    def run(record: bool) -> Bytecode:
+        code = (Op.MSTORE(0, op)
+                + Op.MSTORE(0x20, Op.GAS) + Op.MSTORE(0x40, Op.RESERVOIR)
+                + Op.POP(Op.CALL(Op.GAS, inner, 0, 0, 32, 0x80, 64))
+                + Op.MSTORE(0x60, Op.GAS) + Op.MSTORE(0xC0, Op.RESERVOIR))
+        if record:
+            code += (rec(0, Op.MLOAD(0x80)) + rec(1, Op.MLOAD(0xA0))
+                     + rec(2, Op.ADD(Op.SUB(Op.MLOAD(0x20), Op.MLOAD(0x60)), OFFSET))
+                     + rec(3, Op.ADD(Op.SUB(Op.MLOAD(0x40), Op.MLOAD(0xC0)), OFFSET)))
+        return code
+
+    top = pre.deploy_contract(run(False) + run(True) + Op.STOP, storage=SLOTS)
+    inner_gas = 478   # execution gas of op 2 as seen by the inner frame
+    top_gas = 704     # execution gas of the inner call as seen by the top frame
+    if r:
+        post = {0: enc(inner_gas), 1: enc(-SS), 2: enc(top_gas), 3: enc(-SS)}
+    else:
+        post = {0: enc(inner_gas), 1: enc(-SS), 2: enc(top_gas - SS), 3: enc(0)}
+    state_test(pre=pre, tx=legacy_tx(pre, top, r),
+               post={top: Account(storage={**SLOTS, **post}), shared: Account(storage={})})
