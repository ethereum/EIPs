+@legacy
+@pytest.mark.parametrize("r", [R, 0], ids=["funded", "unfunded"])
+def test_bundler_metering(state_test: StateTestFiller, pre: Alloc, r: int) -> None:
+    """
+    A bundler meters two sub-calls with GAS and with GAS + RESERVOIR.
+    op1 creates a slot in shared contract E, op2 clears it. Stored:
+    slot 0 = op1 reservoir delta (state gas GAS misses),
+    slot 1 = 1 if op2's GAS + RESERVOIR delta is negative.
+    """
+    shared = pre.deploy_contract(Op.SSTORE(FRESH, Op.ISZERO(Op.SLOAD(FRESH))) + Op.STOP)
+    op1 = pre.deploy_contract(Op.POP(Op.CALL(Op.GAS, shared, 0, 0, 0, 0, 0)) + Op.STOP)
+    op2 = pre.deploy_contract(Op.POP(Op.CALL(Op.GAS, shared, 0, 0, 0, 0, 0)) + Op.STOP)
+    # memory: 0x00 gas_before, 0x20 res_before, 0x40 gas_after, 0x60 res_after (op1)
+    #         0x80.. same for op2
+    def meter(target, base):
+        return (Op.MSTORE(base, Op.GAS) + Op.MSTORE(base + 0x20, Op.RESERVOIR)
+                + Op.POP(Op.CALL(16_000_000, target, 0, 0, 0, 0, 0))
+                + Op.MSTORE(base + 0x40, Op.GAS) + Op.MSTORE(base + 0x60, Op.RESERVOIR))
+    total2 = Op.SUB(Op.ADD(Op.MLOAD(0xC0), Op.MLOAD(0xE0)), Op.ADD(Op.MLOAD(0x80), Op.MLOAD(0xA0)))
+    code = (meter(op1, 0x00) + meter(op2, 0x80)
+            + rec(0, Op.SUB(Op.MLOAD(0x20), Op.MLOAD(0x60)))       # op1 reservoir delta
+            + rec(1, Op.SGT(total2, 0))                              # after - before > 0 <=> negative use
+            + Op.STOP)
+    bundler = pre.deploy_contract(code, storage=SLOTS)
+    state_test(pre=pre, tx=legacy_tx(pre, bundler, r),
+               post={bundler: Account(storage={**SLOTS, 0: SS if r else 0, 1: 1})})
+
