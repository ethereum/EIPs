+def test_frame_cross_frame_refill(state_test: StateTestFiller, pre: Alloc) -> None:
+    """
+    Frame 1 creates a slot; frame 2 clears it. The refill is attributed
+    to frame 1's receipt and is not credited to frame 2's pool.
+    """
+    s1, s2 = 300_000, 250_000
+    create_part = Op.SSTORE(FRESH, 1) + rec(0) + Op.STOP
+    head_len = len(Op.JUMPI(0xFF, Op.CALLDATASIZE))
+    dest = head_len + len(create_part)
+    x = pre.deploy_contract(
+        Op.JUMPI(dest, Op.CALLDATASIZE) + create_part
+        + Op.JUMPDEST + Op.SSTORE(FRESH, 0) + rec(1) + Op.STOP, storage=SLOTS)
+    assert len(Op.JUMPI(dest, Op.CALLDATASIZE)) == head_len
+    tx = frame_tx(pre.fund_eoa(),
+                  default_frame(target=x, gas_limit=200_000, state_gas_limit=s1),
+                  default_frame(target=x, gas_limit=200_000, state_gas_limit=s2, data=b"\x01"))
+    state_test(pre=pre, tx=tx, post={x: Account(storage={**SLOTS, 0: s1 - SS, 1: s2})})
+
+
+def test_frame_child_sees_frame_pool(state_test: StateTestFiller, pre: Alloc) -> None:
+    child = pre.deploy_contract(returner(Op.SSTORE(FRESH, 1)))
+    probe = pre.deploy_contract(call_and_record(Op.CALL, child, 1, 0) + Op.STOP, storage=SLOTS)
+    tx = frame_tx(pre.fund_eoa(), default_frame(target=probe, gas_limit=500_000, state_gas_limit=S))
+    state_test(pre=pre, tx=tx, post={probe: Account(storage={**SLOTS, 0: S - SS, 1: S - SS}),
+                                     child: Account(storage={FRESH: 1})})
