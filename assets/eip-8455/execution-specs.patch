+"""
+Regression test of the two-operation example against the deployed ERC-4337
+EntryPoint v0.7 bytecode under the EIP-8037 reservoir model.
+
+Operation 1 creates a storage slot in a shared contract and operation 2
+clears it, in one `handleOps` bundle. The EntryPoint's own accounting
+(`actualGas` inside `innerHandleOp`) is read back from its `deposits`
+mapping: each account starts with no deposit, pays the prefund during
+validation, and is refunded `prefund - actualGasCost` afterwards.
+"""
+
+import pytest
+from eth_abi import encode
+from eth_utils import keccak
+from execution_testing.test_types.chain_config_types import ChainConfigDefaults
+from execution_testing import (
+    Account,
+    Address,
+    Alloc,
+    StateTestFiller,
+    TransactionLog,
+    TransactionReceipt,
+)
+
+from .entrypoint_v07 import (
+    ENTRYPOINT_V07,
+    ENTRYPOINT_V07_IMMUTABLES,
+    MINIMAL_ACCOUNT,
+    MINIMAL_ACCOUNT_IMMUTABLES,
+    SENDER_CREATOR_V07,
+    SHARED,
+)
+from .test_reservoir import R, SS, legacy_tx
+
+pytestmark = [pytest.mark.valid_from("Bogota"), pytest.mark.frame_tx_incompatible]
+
+GAS_PRICE = 10
+VERIFICATION_GAS = 150_000
+CALL_GAS = 300_000
+PRE_VERIFICATION_GAS = 50_000
+PREFUND = (VERIFICATION_GAS + CALL_GAS + PRE_VERIFICATION_GAS) * GAS_PRICE
+USEROP_TYPE = "(address,uint256,bytes,bytes,bytes32,uint256,bytes32,bytes,bytes)"
+HANDLE_OPS = keccak(text=f"handleOps({USEROP_TYPE}[],address)")[:4]
+EXECUTE = keccak(text="execute(address,bytes)")[:4]
+USER_OPERATION_EVENT = keccak(
+    text="UserOperationEvent(bytes32,address,address,uint256,bool,uint256,uint256)"
+)
+SET = keccak(text="set(uint256,uint256)")[:4]
+
+
+def with_immutables(code: bytes, offsets, value: Address) -> bytes:
+    out = bytearray(code)
+    for o in offsets:
+        out[o:o + 32] = bytes(12) + bytes(value)
+    return bytes(out)
+
+
+def user_op(sender: Address, nonce: int, target: Address, data: bytes):
+    call_data = EXECUTE + encode(["address", "bytes"], [str(target), data])
+    return (str(sender), nonce, b"", call_data,
+            (VERIFICATION_GAS << 128 | CALL_GAS).to_bytes(32, "big"), PRE_VERIFICATION_GAS,
+            (GAS_PRICE << 128 | GAS_PRICE).to_bytes(32, "big"), b"", b"")
+
+
+def user_op_hash(op, entrypoint: Address) -> bytes:
+    """`getUserOpHash` of EntryPoint v0.7: keccak(abi.encode(hash(op), entryPoint, chainid))."""
+    sender, nonce, init_code, call_data, limits, pre_gas, fees, pm, _sig = op
+    inner = keccak(encode(
+        ["address", "uint256", "bytes32", "bytes32", "bytes32", "uint256", "bytes32", "bytes32"],
+        [sender, nonce, keccak(init_code), keccak(call_data), limits, pre_gas, fees, keccak(pm)]))
+    return keccak(encode(["bytes32", "address", "uint256"], [inner, str(entrypoint), ChainConfigDefaults.chain_id]))
+
+
+def user_op_event(entrypoint: Address, op, account: Address, gas: int) -> TransactionLog:
+    """`UserOperationEvent` with `success = true` and the charged gas."""
+    return TransactionLog(
+        address=entrypoint,
+        topics=[USER_OPERATION_EVENT, user_op_hash(op, entrypoint),
+                bytes(12) + bytes(account), bytes(32)],
+        data=encode(["uint256", "bool", "uint256", "uint256"], [0, True, gas * GAS_PRICE, gas]),
+    )
+
+
+def deposit_key(account: Address) -> int:
+    return int.from_bytes(keccak(bytes(12) + bytes(account) + bytes(32)), "big")
+
+
+def nonce_key(account: Address) -> int:
+    inner = keccak(bytes(12) + bytes(account) + (1).to_bytes(32, "big"))
+    return int.from_bytes(keccak(bytes(32) + inner), "big")
+
+
+@pytest.mark.parametrize("variant,r,gas1,gas2", [
+    ("create_clear", R, 138_225, 124_740),
+    ("create_clear", 0, 324_273, 222_660),
+    ("create_keep", R, 138_225, 124_740),
+    ("control", R, 138_225, 124_740),
+], ids=["create_clear", "create_clear_below_cap", "create_keep", "control"])
+def test_entrypoint_v07_two_ops(state_test: StateTestFiller, pre: Alloc, variant: str, r: int,
+                                gas1: int, gas2: int) -> None:
+    """
+    `gas1` and `gas2` are the `actualGas` values the EntryPoint charges the
+    two accounts, read from `deposits`. In the control both operations write
+    a slot that is already non-zero, so no state gas is charged or refilled.
+    """
+    sender_creator = pre.deploy_contract(SENDER_CREATOR_V07)
+    entrypoint = pre.deploy_contract(
+        with_immutables(ENTRYPOINT_V07, ENTRYPOINT_V07_IMMUTABLES, sender_creator),
+        storage={2: 1},  # ReentrancyGuard NOT_ENTERED, as set by the constructor
+    )
+    account_code = with_immutables(MINIMAL_ACCOUNT, MINIMAL_ACCOUNT_IMMUTABLES, entrypoint)
+    acct1 = pre.deploy_contract(account_code, balance=10**18)
+    acct2 = pre.deploy_contract(account_code, balance=10**18)
+    key = 7
+    slot = int.from_bytes(keccak(key.to_bytes(32, "big") + bytes(32)), "big")
+    shared = pre.deploy_contract(SHARED, storage={slot: 5} if variant == "control" else {})
+    beneficiary = pre.fund_eoa(amount=0)
+
+    def set_call(value: int) -> bytes:
+        return SET + encode(["uint256", "uint256"], [key, value])
+
+    ops = [user_op(acct1, 0, shared, set_call(1 if variant != "control" else 6)),
+           user_op(acct2, 0, shared, set_call(0 if variant == "create_clear" else
+                                              (1 if variant == "create_keep" else 7)))]
+    data = HANDLE_OPS + encode([f"{USEROP_TYPE}[]", "address"], [ops, str(beneficiary)])
+    # Logs: for each account an EIP-7708 Transfer of the prefund and a
+    # Deposited event, then BeforeExecution, one UserOperationEvent per
+    # operation, and the Transfer of the collected fees to the beneficiary.
+    # The two UserOperationEvents are pinned: success, userOpHash, sender,
+    # nonce, actualGasCost and actualGasUsed; the other logs are wildcards.
+    wildcard = TransactionLog()
+    receipt = TransactionReceipt(logs=[
+        wildcard, wildcard, wildcard, wildcard, wildcard,
+        user_op_event(entrypoint, ops[0], acct1, gas1),
+        user_op_event(entrypoint, ops[1], acct2, gas2),
+        wildcard,
+    ])
+    tx = legacy_tx(pre, entrypoint, r, data=data, expected_receipt=receipt)
+
+    final = {"create_clear": {}, "create_keep": {slot: 1}, "control": {slot: 7}}[variant]
+    state_test(
+        pre=pre, tx=tx,
+        post={
+            shared: Account(storage=final),
+            entrypoint: Account(storage={
+                2: 1,
+                deposit_key(acct1): PREFUND - gas1 * GAS_PRICE,
+                deposit_key(acct2): PREFUND - gas2 * GAS_PRICE,
+                nonce_key(acct1): 1,
+                nonce_key(acct2): 1,
+            }),
+            beneficiary: Account(balance=(gas1 + gas2) * GAS_PRICE),
+        },
+    )
