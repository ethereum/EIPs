+DEPLOYED = bytes([0x00]) * 10   # 10 bytes of runtime code
+
+
+def initcode(ending: str) -> Bytecode:
+    body = rec(0)  # value is read before the new slot's own charge
+    if ending == "return":
+        return body + Op.MSTORE(0, 0) + Op.RETURN(0, len(DEPLOYED))
+    return body + Op.REVERT(0, 0)
