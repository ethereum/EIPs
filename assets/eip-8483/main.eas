;;; Post-quantum material registration request contract.
;;;
;;; An EIP-7685 request contract in the style of EIP-7002 / EIP-7251. A caller
;;; (expected to be the execution address in a validator's withdrawal
;;; credentials) submits a 48-byte validator public key followed by 64 bytes of
;;; opaque post-quantum material. The contract charges the EIP-7002 style
;;; dynamic fee, queues a record of
;;;
;;;     source_address (20) ++ validator_pubkey (48) ++ pq_data (64)
;;;
;;; and, when called by the system address at the end of a block, dequeues up
;;; to MAX_PER_BLOCK records and returns them concatenated. The consensus layer
;;; checks that source_address controls the validator.
;;;
;;; The queue follows the EIP-7251 consolidation request contract, with one
;;; more storage slot per item. Unlike EIP-7002, EIP-7251 and EIP-8282, the fee
;;; state is updated on the write path rather than by the system call: the
;;; first write in a block folds the previous active block's count into the
;;; excess and decays it by TARGET_PER_BLOCK for every elapsed block. The fee
;;; therefore depends only on how fast requests are added, not on whether the
;;; system call is running, so registrations can be queued before the fork that
;;; starts draining them. At most MAX_ADDS_PER_BLOCK requests can be added per
;;; block. As in EIP-8282, a system call with non-empty calldata disables the
;;; queue by setting the excess inhibitor.

#pragma target "prague"

;;; ----------------------------------------------------------------------------
;;; CONSTANTS ------------------------------------------------------------------
;;; ----------------------------------------------------------------------------

#define SYSTEM_ADDR = .address(0xfffffffffffffffffffffffffffffffffffffffe)

#define SLOT_EXCESS = 0
#define SLOT_COUNT = 1

#define QUEUE_HEAD = 2
#define QUEUE_TAIL = 3
#define SLOT_LAST_BLOCK = 4
#define QUEUE_OFFSET = 5

#define MIN_FEE = 1
#define TARGET_PER_BLOCK = 128
#define MAX_ADDS_PER_BLOCK = 256
#define MAX_PER_BLOCK = 1024
#define FEE_UPDATE_FRACTION = 17
#define EXCESS_INHIBITOR = 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff

#define INPUT_SIZE = 112   ; the size of (pubkey ++ pq_data)
#define RECORD_SIZE = 132  ; the size of (address ++ pubkey ++ pq_data)
#define SLOTS_PER_ITEM = 5 ; (addr, pk[0:32], pk[32:48]++data[0:16], data[16:48], data[48:64])

;;; ----------------------------------------------------------------------------
;;; PROGRAM START --------------------------------------------------------------
;;; ----------------------------------------------------------------------------

    ;; Dispatch to the system subroutine if called by the system address.
    caller                 ; [caller]
    push SYSTEM_ADDR       ; [sysaddr, caller]
    eq                     ; [sysaddr == caller]
    jumpi @read_requests   ; []

;;; ----------------------------------------------------------------------------
;;; USER SUBROUTINE ------------------------------------------------------------
;;; ----------------------------------------------------------------------------

    ;; Load the persisted excess.
    push SLOT_EXCESS       ; [excess_slot]
    sload                  ; [excess]

    ;; Revert while the inhibitor is set (the queue is disabled).
    dup1                   ; [excess, excess]
    push EXCESS_INHIBITOR  ; [inhibitor, excess, excess]
    eq                     ; [inhibitor == excess, excess]
    jumpi @revert          ; [excess]

    ;; Load the count of requests added in the last active block.
    push SLOT_COUNT        ; [count_slot, excess]
    sload                  ; [count, excess]
    push SLOT_LAST_BLOCK   ; [last_slot, count, excess]
    sload                  ; [last, count, excess]
    dup1                   ; [last, last, count, excess]
    number                 ; [number, last, last, count, excess]
    eq                     ; [number == last, last, count, excess]
    jumpi @same_block      ; [last, count, excess]

    ;; First request of this block: roll the fee state forward.
    ;;   excess = max(0, excess + count - TARGET_PER_BLOCK * (number - last))
    ;;   count = 0
    number                 ; [number, last, count, excess]
    sub                    ; [elapsed, count, excess]
    push TARGET_PER_BLOCK  ; [target, elapsed, count, excess]
    mul                    ; [decay, count, excess]
    swap2                  ; [excess, count, decay]
    add                    ; [excess+count, decay]
    dup2                   ; [decay, excess+count, decay]
    dup2                   ; [excess+count, decay, excess+count, decay]
    gt                     ; [excess+count > decay, excess+count, decay]
    jumpi @decay_excess    ; [excess+count, decay]

    pop                    ; [decay]
    pop                    ; []
    push 0                 ; [excess]
    jump @new_block        ; [excess]

decay_excess:              ; [excess+count, decay]
    sub                    ; [excess]

new_block:                 ; [excess]
    push 0                 ; [count, excess]
    swap1                  ; [excess, count]
    jump @compute_user_fee ; [excess, count]

same_block:                ; [last, count, excess]
    pop                    ; [count, excess]
    swap1                  ; [excess, count]

compute_user_fee:          ; [excess, count]
    ;; Include the requests already added in this block: if the block count
    ;; exceeds TARGET_PER_BLOCK, add the difference to the exponent.
    push TARGET_PER_BLOCK  ; [target, excess, count]
    dup3                   ; [count, target, excess, count]
    gt                     ; [count > target, excess, count]
    jumpi @bump_exponent   ; [excess, count]

    dup1                   ; [excess, excess, count]
    jump @fee              ; [excess, excess, count]

bump_exponent:             ; [excess, count]
    push TARGET_PER_BLOCK  ; [target, excess, count]
    dup3                   ; [count, target, excess, count]
    sub                    ; [count-target, excess, count]
    dup2                   ; [excess, count-target, excess, count]
    add                    ; [exponent, excess, count]

fee:                       ; [exponent, excess, count]
    push FEE_UPDATE_FRACTION ; [update_fraction, exponent, excess, count]
    swap1                  ; [exponent, update_fraction, excess, count]
    push MIN_FEE           ; [min_fee, exponent, update_fraction, excess, count]

#include "fake_expo.eas"

    ;; If calldatasize matches the expected input size, add the request.
    calldatasize           ; [calldatasize, req_fee, excess, count]
    push INPUT_SIZE        ; [INPUT_SIZE, calldatasize, req_fee, excess, count]
    eq                     ; [INPUT_SIZE == calldatasize, req_fee, excess, count]
    jumpi @handle_input    ; [req_fee, excess, count]

    ;; Otherwise calldatasize must be zero (fee getter).
    calldatasize           ; [calldatasize, req_fee, excess, count]
    jumpi @revert          ; [req_fee, excess, count]

    ;; Reject any value on the read path to prevent lost funds.
    callvalue              ; [value, req_fee, excess, count]
    jumpi @revert          ; [req_fee, excess, count]

    ;; Return req_fee.
    push 0                 ; [0, req_fee, excess, count]
    mstore                 ; [excess, count]
    push 32                ; [32]
    push 0                 ; [0, 32]
    return                 ; []

handle_input:
    ;; Write path. Input layout:
    ;;
    ;;  +--------+---------+
    ;;  | pubkey | pq_data |
    ;;  +--------+---------+
    ;;      48        64

    ;; Check that the value covers the fee.
    callvalue              ; [callvalue, req_fee, excess, count]
    lt                     ; [callvalue < req_fee, excess, count]
    jumpi @revert          ; [excess, count]

    ;; Enforce the per-block limit on added requests.
    push MAX_ADDS_PER_BLOCK ; [max_adds, excess, count]
    dup3                   ; [count, max_adds, excess, count]
    lt                     ; [count < max_adds, excess, count]
    iszero                 ; [count >= max_adds, excess, count]
    jumpi @revert          ; [excess, count]

    ;; Persist the fee state: excess, count+1 and the current block number.
    push SLOT_EXCESS       ; [excess_slot, excess, count]
    sstore                 ; [count]
    push 1                 ; [1, count]
    add                    ; [count+1]
    push SLOT_COUNT        ; [count_slot, count+1]
    sstore                 ; []
    number                 ; [number]
    push SLOT_LAST_BLOCK   ; [last_slot, number]
    sstore                 ; []

    ;; Compute the base storage slot of the new queue item.
    push QUEUE_TAIL        ; [tail_idx_slot]
    sload                  ; [tail_idx]
    dup1                   ; [tail_idx, tail_idx]
    push SLOTS_PER_ITEM    ; [slots, tail_idx, tail_idx]
    mul                    ; [slots*tail_idx, tail_idx]
    push QUEUE_OFFSET
    add                    ; [slot, tail_idx]

    ;; Slot 0: source address.
    caller                 ; [caller, slot, ..]
    dup2                   ; [slot, caller, slot, ..]
    sstore                 ; [slot, ..]
    push 1                 ; [1, slot, ..]
    add                    ; [slot, ..]

    ;; Slot 1: pubkey[0:32].
    push 0                 ; [0, slot, ..]
    calldataload           ; [pubkey[0:32], slot, ..]
    dup2                   ; [slot, pubkey[0:32], slot, ..]
    sstore                 ; [slot, ..]
    push 1                 ; [1, slot, ..]
    add                    ; [slot, ..]

    ;; Slot 2: pubkey[32:48] ++ pq_data[0:16].
    push 32                ; [32, slot, ..]
    calldataload           ; [pubkey[32:48] ++ pq_data[0:16], slot, ..]
    dup2                   ; [slot, pubkey[32:48] ++ pq_data[0:16], slot, ..]
    sstore                 ; [slot, ..]
    push 1                 ; [1, slot, ..]
    add                    ; [slot, ..]

    ;; Slot 3: pq_data[16:48].
    push 64                ; [64, slot, ..]
    calldataload           ; [pq_data[16:48], slot, ..]
    dup2                   ; [slot, pq_data[16:48], slot, ..]
    sstore                 ; [slot, ..]
    push 1                 ; [1, slot, ..]
    add                    ; [slot, ..]

    ;; Slot 4: pq_data[48:64] ++ 16 zero bytes (calldataload zero-pads).
    push 96                ; [96, slot, ..]
    calldataload           ; [pq_data[48:64] ++ 0x00..00, slot, ..]
    swap1                  ; [slot, pq_data[48:64] ++ 0x00..00, ..]
    sstore                 ; [..]

    ;; Assemble the log record: caller ++ calldata.
    caller                 ; [caller, ..]
    push 96                ; [96, caller, ..]
    shl                    ; [caller<<96, ..]
    push 0                 ; [0, caller<<96, ..]
    mstore                 ; [..]
    push INPUT_SIZE        ; [size, ..]
    push 0                 ; [ost, size, ..]
    push 20                ; [dest, ost, size, ..]
    calldatacopy           ; [..]

    ;; Log the record.
    push RECORD_SIZE       ; [size, ..]
    push 0                 ; [idx, size, ..]
    log0                   ; [..]

    ;; Advance the queue tail.
    push 1                 ; [1, tail_idx]
    add                    ; [tail_idx+1]
    push QUEUE_TAIL        ; [tail_idx_slot, tail_idx+1]
    sstore                 ; []

    stop

;;; ----------------------------------------------------------------------------
;;; SYSTEM SUBROUTINE ----------------------------------------------------------
;;; ----------------------------------------------------------------------------
;;;
;;; Dequeue up to MAX_PER_BLOCK records and return them as a contiguous byte
;;; array of RECORD_SIZE byte records:
;;;
;;;  +------+--------+---------+
;;;  | addr | pubkey | pq_data |
;;;  +------+--------+---------+
;;;     20      48        64
;;;
;;; Then handle the excess inhibitor.

read_requests:
    ;; count = tail - head
    push QUEUE_TAIL        ; [tail_idx_slot]
    sload                  ; [tail_idx]
    push QUEUE_HEAD        ; [head_idx_slot, tail_idx]
    sload                  ; [head_idx, tail_idx]
    dup1                   ; [head_idx, head_idx, tail_idx]
    dup3                   ; [tail_idx, head_idx, head_idx, tail_idx]
    sub                    ; [count, head_idx, tail_idx]

    ;; count = min(count, MAX_PER_BLOCK)
    dup1                   ; [count, count, head_idx, tail_idx]
    push MAX_PER_BLOCK     ; [max, count, count, head_idx, tail_idx]
    gt                     ; [max > count, count, head_idx, tail_idx]
    jumpi @begin_loop      ; [count, head_idx, tail_idx]
    pop                    ; [head_idx, tail_idx]
    push MAX_PER_BLOCK     ; [count, head_idx, tail_idx]

begin_loop:
    push 0                 ; [i, count, head_idx, tail_idx]

accum_loop:
    ;; Exit when i == count.
    dup2                   ; [count, i, count, head_idx, tail_idx]
    dup2                   ; [i, count, i, count, head_idx, tail_idx]
    eq                     ; [i == count, i, count, head_idx, tail_idx]
    jumpi @update_head     ; [i, count, head_idx, tail_idx]

    ;; slotbase = QUEUE_OFFSET + (head_idx + i) * SLOTS_PER_ITEM
    dup3                   ; [head_idx, i, ..]
    dup2                   ; [i, head_idx, i, ..]
    add                    ; [i+head_idx, i, ..]
    push SLOTS_PER_ITEM    ; [5, i+head_idx, i, ..]
    mul                    ; [5*(i+head_idx), i, ..]
    push QUEUE_OFFSET      ; [offset, 5*(i+head_idx), i, ..]
    add                    ; [slotbase, i, ..]

    ;; offset = i * RECORD_SIZE
    dup2                   ; [i, slotbase, i, ..]
    push RECORD_SIZE       ; [size, i, slotbase, i, ..]
    mul                    ; [offset, slotbase, i, ..]

    ;; mem[offset:offset+20] = addr
    dup2                   ; [slotbase, offset, slotbase, ..]
    sload                  ; [addr, offset, slotbase, ..]
    push 96                ; [96, addr, offset, slotbase, ..]
    shl                    ; [addr<<96, offset, slotbase, ..]
    dup2                   ; [offset, addr<<96, offset, slotbase, ..]
    mstore                 ; [offset, slotbase, ..]
    push 20                ; [20, offset, slotbase, ..]
    add                    ; [offset+20, slotbase, ..]

    ;; mem[offset+20:offset+52] = pubkey[0:32]
    dup2                   ; [slotbase, offset, slotbase, ..]
    push 1                 ; [1, slotbase, offset, slotbase, ..]
    add                    ; [slot, offset, slotbase, ..]
    sload                  ; [pk1, offset, slotbase, ..]
    dup2                   ; [offset, pk1, offset, slotbase, ..]
    mstore                 ; [offset, slotbase, ..]
    push 32                ; [32, offset, slotbase, ..]
    add                    ; [offset+32, slotbase, ..]

    ;; mem[offset+52:offset+84] = pubkey[32:48] ++ pq_data[0:16]
    dup2                   ; [slotbase, offset, slotbase, ..]
    push 2                 ; [2, slotbase, offset, slotbase, ..]
    add                    ; [slot, offset, slotbase, ..]
    sload                  ; [pk2_d1, offset, slotbase, ..]
    dup2                   ; [offset, pk2_d1, offset, slotbase, ..]
    mstore                 ; [offset, slotbase, ..]
    push 32                ; [32, offset, slotbase, ..]
    add                    ; [offset+32, slotbase, ..]

    ;; mem[offset+84:offset+116] = pq_data[16:48]
    dup2                   ; [slotbase, offset, slotbase, ..]
    push 3                 ; [3, slotbase, offset, slotbase, ..]
    add                    ; [slot, offset, slotbase, ..]
    sload                  ; [d2, offset, slotbase, ..]
    dup2                   ; [offset, d2, offset, slotbase, ..]
    mstore                 ; [offset, slotbase, ..]
    push 32                ; [32, offset, slotbase, ..]
    add                    ; [offset+32, slotbase, ..]

    ;; mem[offset+116:offset+132] = pq_data[48:64]. The 16 trailing zero bytes
    ;; spill into the next record, which overwrites them, or past the returned
    ;; range.
    swap1                  ; [slotbase, offset, ..]
    push 4                 ; [4, slotbase, offset, ..]
    add                    ; [slot, offset, ..]
    sload                  ; [d3, offset, ..]
    swap1                  ; [offset, d3, ..]
    mstore                 ; [i, count, head_idx, tail_idx]

    ;; i += 1
    push 1                 ; [1, i, ..]
    add                    ; [i+1, ..]
    jump @accum_loop       ; [i, count, head_idx, tail_idx]

update_head:               ; [i, count, head_idx, tail_idx]
    swap2                  ; [head_idx, count, i, tail_idx]
    add                    ; [new_head_idx, count, tail_idx]

    ;; If the queue is now empty, reset head and tail.
    dup1                   ; [new_head_idx, new_head_idx, count, tail_idx]
    swap3                  ; [tail_idx, new_head_idx, count, new_head_idx]
    eq                     ; [new_head_idx == tail_idx, count, new_head_idx]
    jumpi @reset_queue     ; [count, new_head_idx]

    ;; Otherwise store the new head.
    swap1                  ; [new_head_idx, count]
    push QUEUE_HEAD        ; [head_idx_slot, new_head_idx, count]
    sstore                 ; [count]
    jump @update_excess    ; [count]

reset_queue:
    swap1                  ; [new_head_idx, count]
    pop                    ; [count]
    push 0                 ; [0, count]
    push QUEUE_HEAD        ; [head_slot, 0, count]
    sstore                 ; [count]
    push 0                 ; [0, count]
    push QUEUE_TAIL        ; [tail_slot, 0, count]
    sstore                 ; [count]

update_excess:
    ;; The fee state is maintained by the write path. The system call only
    ;; manages the inhibitor: any calldata disables the queue, and a call with
    ;; empty calldata re-enables a disabled queue.
    calldatasize           ; [calldatasize, count]
    jumpi @set_inhibitor   ; [count]

    push SLOT_EXCESS       ; [excess_slot, count]
    sload                  ; [excess, count]
    push EXCESS_INHIBITOR  ; [inhibitor, excess, count]
    eq                     ; [inhibitor == excess, count]
    iszero                 ; [inhibitor != excess, count]
    jumpi @return_records  ; [count]

    ;; Re-enable the queue with a fresh fee state.
    push 0                 ; [0, count]
    push SLOT_EXCESS       ; [excess_slot, 0, count]
    sstore                 ; [count]
    push 0                 ; [0, count]
    push SLOT_COUNT        ; [count_slot, 0, count]
    sstore                 ; [count]
    jump @return_records   ; [count]

set_inhibitor:             ; [count]
    push EXCESS_INHIBITOR  ; [inhibitor, count]
    push SLOT_EXCESS       ; [excess_slot, inhibitor, count]
    sstore                 ; [count]

return_records:            ; [count]
    ;; Return count * RECORD_SIZE bytes.
    push RECORD_SIZE       ; [record_size, count]
    mul                    ; [size]
    push 0                 ; [0, size]
    return                 ; []

revert:                    ; [...]
    push 0                 ; [size]
    push 0                 ; [offset, size]
    revert                 ; []
